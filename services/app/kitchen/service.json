{
  "port": 4101,
  "dependsOn": [],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "dev": {
    "command": "bun run dev",
    "watch": [
      "src/**/*"
    ]
  },
  "healthCheckPath": "/health",
  "$schema": "https://flisk.sh/schema.service.json",
